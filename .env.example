DATABASE_URL="postgresql://postgres:password@localhost:5432/jprty"
BETTER_AUTH_SECRET="local-dev-secret-change-me"
BETTER_AUTH_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000"
GAME_SERVER_URL="http://localhost:8080"
NEXT_PUBLIC_SOCKET_URL="http://localhost:8080"

# Server/runtime SpacetimeDB config (private server env)
# apps/web server-side createRoom provisioning and game.getGameState mirrored
# reads use these values when configured.
# - createRoom provisioning: attempts sync_live_room when URL+database are set,
#   then falls back to GAME_SERVER_URL on disabled/missing config or failure.
# - joinRoom/leaveRoom membership mirroring: attempts sync_live_room_player /
#   remove_live_room_player when URL+database are set, and warn+continues on
#   missing config or reducer failure.
# - game.getGameState reads: requires SPACETIMEDB_READS_ENABLED=true and falls
#   back to GAME_SERVER_URL on missing config/state or read failure.
# These are server-only variables. Do not expose through NEXT_PUBLIC_*.
SPACETIMEDB_URL=""
SPACETIMEDB_DATABASE=""
SPACETIMEDB_TOKEN=""
SPACETIMEDB_READS_ENABLED="false"

# Web/Vercel SpacetimeDB read config (exposed to browser)
NEXT_PUBLIC_LIVE_RUNTIME_BACKEND="prisma-socket-bridge"
NEXT_PUBLIC_SPACETIMEDB_URL=""
NEXT_PUBLIC_SPACETIMEDB_DATABASE=""
NEXT_PUBLIC_SPACETIMEDB_POLL_MS="2000"

NODE_ENV="development"
PORT="8080"
