{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [ "NODE_ENV" ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "^db:generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "POSTGRES_URL",
        "POSTGRES_PRISMA_URL",
        "DATABASE_URL_UNPOOLED",
        "POSTGRES_URL_NON_POOLING",
        "PGHOST",
        "POSTGRES_USER",
        "POSTGRES_PASSWORD",
        "POSTGRES_DATABASE",
        "PGPASSWORD",
        "PGDATABASE",
        "PGHOST_UNPOOLED",
        "PGUSER",
        "POSTGRES_URL_NO_SSL",
        "POSTGRES_HOST",
        "NEON_PROJECT_ID",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "SPACETIMEDB_URL",
        "SPACETIMEDB_DATABASE",
        "SPACETIMEDB_TOKEN",
        "SPACETIMEDB_READS_ENABLED",
        "NEXT_PUBLIC_LIVE_RUNTIME_BACKEND",
        "NEXT_PUBLIC_SPACETIMEDB_URL",
        "NEXT_PUBLIC_SPACETIMEDB_DATABASE",
        "NEXT_PUBLIC_SPACETIMEDB_POLL_MS",
        "NEXT_PUBLIC_SOCKET_URL"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "start": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "cache": false
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "dependsOn": [
        "^db:generate"
      ],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "db:deploy": {
      "cache": false,
      "env": ["DATABASE_URL"]
    }
  }
}
